if (-r $prj.xyw) then 

echo -n Plot RAIN. 
awk '{print($1,$2,$10/1e3)}' $prj.xyw |\
	xyz2grd	-G$tmp.rain.grd.tmp -I$dx/$dy -R -H2

set rain_min = `grdinfo -C $tmp.rain.grd.tmp | awk '{print $6}'`
set rain_max = `grdinfo -C $tmp.rain.grd.tmp | awk '{print $7}'`
set rain_diff = `echo "$rain_max - $rain_min" | bc -l`
set is_uniform = `echo "$rain_diff < 1e-4" | bc -l`

set min_rain_cpt = `echo "$rain_min + 0.5 * $rain_diff" | bc -l`
grdclip $tmp.rain.grd.tmp -G$tmp.rain.grd.tmp -Sb$min_rain_cpt/NaN
cat - <<END>  $tmp.rain_cpt.tmp 
#0		255	150	0	$min_rain_cpt 255	255	0
$min_rain_cpt 	21      234     255     1     21      234     255
1        	64      200     255     1.5       64      200     255
1.5       	106     149     255     2     106     149     255
2       	149     106     255     3       149     106     255
3       	212     43      255     5       212     43      255
B       0       0       0
F       230     0       255
N       128     128     190
END
grdimage $tmp.rain.grd.tmp -C$tmp.rain_cpt.tmp -JX -R -Q -O -K >> $ps
grdcontour $tmp.top.grd.tmp -JX -R -C$tmp.topo_palet.tmp -W1 -O -K >> $ps

endif
